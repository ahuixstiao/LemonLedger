<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程 -->
    <parent>
        <groupId>com.ahui</groupId>
        <artifactId>LemonLedger</artifactId>
        <version>0.0.2</version>
    </parent>

    <artifactId>ledger-db</artifactId>
    <version>0.0.2</version>
    <name>ledger-db</name>

    <dependencies>
        <!-- 继承公共模块 -->
        <dependency>
            <groupId>com.ahui</groupId>
            <artifactId>ledger-common</artifactId>
            <version>0.0.2</version>
        </dependency>

        <!-- druid数据库连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>

        <!-- 引入mysql数据库依赖。
             注意坐标：Boot 2.7.18 的依赖管理里管的是 com.mysql:mysql-connector-j，
             旧的 mysql:mysql-connector-java 已不再被管理（升级到 2.7.18 后会报 version missing）。
             driver-class-name 仍然是 com.mysql.cj.jdbc.Driver，配置不用改。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
