<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- spring-boot框架 父工程 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <!-- 程序信息 -->
    <groupId>com.ahui</groupId> <!--程序所属组织或作者-->
    <artifactId>LemonLedger</artifactId>
    <version>0.0.2</version> <!-- 程序版本 -->
    <name>LemonLedger</name> <!-- 程序名称 -->

    <!--
    父工程的打包方式必须为pom
    父工程本身不包含具体的逻辑代码和资源
    将父工程的packaging设为pom表示该项目为聚合项目
    -->
    <packaging>pom</packaging>

    <!-- 子模块 -->
    <modules>
        <module>ledger-api</module>
        <module>ledger-db</module>
        <module>ledger-common</module>
    </modules>

    <!-- 版本信息配置 -->
    <properties>
        <java.version>17</java.version> <!-- 指定java版本 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 打包时调用的 npm 命令：Windows 上必须是 npm.cmd。
             Maven 用 ProcessBuilder 直接 exec，找不到不带扩展名的 npm（下面 windows profile 会自动切换） -->
        <npm.executable>npm</npm.executable>

        <!-- 前端构建（esbuild）的临时目录。不要用系统 TEMP：
             本机 360/Defender 会锁住 esbuild 解出来的临时 exe，删不掉就报
             [vite:esbuild-transpile] remove ...\Temp\esbuild-xxx: Access is denied -->
        <npm.tmpdir>${session.executionRootDirectory}/.npm-tmp</npm.tmpdir>

        <!-- mybatis-plus 版本 -->
        <mybatisPlus.version>3.5.14</mybatisPlus.version>
        <jsqlparser.version>4.9</jsqlparser.version>
        <!-- druid数据库连接池 版本 -->
        <druid.version>1.2.25</druid.version>
        <!-- fastjson2 版本 -->
        <fastjson2.version>2.0.57</fastjson2.version>
        <!-- hutool 版本 -->
        <hutool.version>5.8.39</hutool.version>

        <!-- spring boot 版本 -->
        <spring-boot.version>2.7.18</spring-boot.version>

        <fastexcel.version>1.3.0</fastexcel.version>
    </properties>

    <!-- 全局依赖 2个及以上的子模块依赖的第三方组件就放在该处 -->
    <dependencyManagement>
        <dependencies>

            <!-- spring-boot框架整合的web模块依赖组 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <!-- mybatis-plus 插件管理bom，mybatisPlus所有插件和主体版本都由该依赖管理 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatisPlus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>

            <!-- druid数据库连接池 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- HuTool 第三方类库 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- fastjson2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2-extension</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- fast excel easy excel的迭代 -->
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Windows 上 npm 只能通过 npm.cmd 启动：
             Maven 用 ProcessBuilder 直接执行命令，不会像 cmd 那样按 PATHEXT 补扩展名，
             所以打包时若写成 "npm" 会报 CreateProcess error=2（系统找不到指定的文件） -->
        <profile>
            <id>npm-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <npm.executable>npm.cmd</npm.executable>
            </properties>
        </profile>
    </profiles>

</project>
